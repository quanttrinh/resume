{
  "name": "Resume",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers-contrib/features/mise:1": {}
  },
  "containerEnv": {
    "MISE_TRUSTED_CONFIG_PATHS": "/workspaces/resume"
  },
  "postCreateCommand": "mise install",
  "customizations": {
    "vscode": {
      "extensions": [
        "james-yu.latex-workshop"
      ]
    }
  }
}
