#!/usr/bin/env bash
#MISE description="Build one variant -> build/resume-<tag>.pdf"
#
# Adding a knob means: a default below, a line in build-vars.tex, and a
# \providecommand in resumestyle.sty.
set -euo pipefail

# Not in mise.toml's [env], which would *override* the caller's environment
# rather than default it: `VARIANT=short mise run build`.
ENGINE="${ENGINE:-tectonic}"
VARIANT="${VARIANT:-full}"
DATE="${DATE:-$(date +%Y-%m-%d)}"
PAGE_BUDGET="${PAGE_BUDGET:-1}"     # 0 disables the length warning
SKILLS_BOTTOM="${SKILLS_BOTTOM:-0}" # 1 pushes that section below Experience
EDUCATION_BOTTOM="${EDUCATION_BOTTOM:-0}"
OUT="${OUT:-build}"

# Suffixed so variants never overwrite each other.
tag="$VARIANT"
[ "$SKILLS_BOTTOM" = "1" ] && tag="$tag-skillsbottom"
[ "$EDUCATION_BOTTOM" = "1" ] && tag="$tag-edubottom"

pdf="$OUT/resume-$tag.pdf"
manifest="$OUT/resume-$tag.json"
mkdir -p "$OUT"

{
	printf '%% generated by mise -- do not edit\n'
	printf '\\renewcommand{\\buildvariant}{%s}\n' "$VARIANT"
	printf '\\renewcommand{\\builddate}{%s}\n' "$DATE"
	[ "$SKILLS_BOTTOM" = "1" ] && printf '\\skillsbottom\n'
	[ "$EDUCATION_BOTTOM" = "1" ] && printf '\\educationbottom\n'
	true
} > build-vars.tex

"$ENGINE" --keep-logs resume.tex --outdir "$OUT"
mv "$OUT/resume.pdf" "$pdf"

# resumestyle.sty logs RESUME-PAGES=<n>, so no PDF tool is needed for a count.
pages=$(grep -o 'RESUME-PAGES=[0-9]*' "$OUT/resume.log" | tail -1 | cut -d= -f2)
pages="${pages:-?}"
bytes=$(wc -c < "$pdf" | tr -d ' ')

bool() { [ "$1" = "1" ] && echo true || echo false; }
printf '{"file":"%s","variant":"%s","skills_bottom":%s,"education_bottom":%s,"pages":"%s","bytes":%s,"date":"%s","engine":"%s"}\n' \
	"$(basename "$pdf")" "$VARIANT" \
	"$(bool "$SKILLS_BOTTOM")" "$(bool "$EDUCATION_BOTTOM")" \
	"$pages" "$bytes" "$DATE" "$("$ENGINE" --version | head -1)" \
	> "$manifest"

if [ "$PAGE_BUDGET" != "0" ] && [ "$pages" != "?" ] && [ "$pages" -gt "$PAGE_BUDGET" ]; then
	msg="$pdf is $pages pages (budget: $PAGE_BUDGET)"
	[ -n "${GITHUB_ACTIONS:-}" ] && echo "::warning title=Résumé too long::$msg"
	echo "warning: $msg" >&2
fi

echo "-> $pdf  (variant=$VARIANT, date=$DATE, skills_bottom=$SKILLS_BOTTOM, education_bottom=$EDUCATION_BOTTOM)"
